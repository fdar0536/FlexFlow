# TCP port used for the build synchronization lock.
#
# Some build steps are not safe to execute concurrently.
# This port is used to coordinate those steps so that only one build
# process can execute them at a time.
#
# Default: 54321
BUILD_LOCK_PORT = 54321

# C++ build settings

# CMake build-system generator.
# Default: Ninja
CMAKE_GENERATOR = "Ninja"

# C++ build directory.
# Default: <TEMP>/build-cpp
CPP_BUILD_DIR = "/tmp/build-cpp"

# CMake build configuration.
# Common values: Debug, Release, RelWithDebInfo, MinSizeRel
# Default: Release
BUILD_TYPE = "Release"

# Additional arguments passed to CMake during configuration.
# Example:
# -DCMAKE_TOOLCHAIN_FILE=/path/to/your/conan_toolchain.cmake
# Default: ""
CMAKE_EXTRA_ARGS = ""

# Maximum number of parallel build jobs.
# Default: 1
JOBS = 1

# C++ component settings

# At least one C++ component must be enabled.
# If both ENABLE_SERVER and ENABLE_CLI are disabled,
# ENABLE_SERVER will be enabled automatically.

# Enable or disable building the server.
# Valid values: 0 (disabled), 1 (enabled)
# Default: 1
ENABLE_SERVER = 1

# Enable or disable building the CLI.
# Valid values: 0 (disabled), 1 (enabled)
# Default: 1
ENABLE_CLI = 1

# Model settings

# Timeout, in seconds, for the model's built-in gRPC client.
# Valid range: 1-61, inclusive.
# Values outside this range are automatically reset to the default.
# Default: 31
MODEL_CLIENT_TIMEOUT = 31

# Buffer size, in bytes, used for each read from a child process's
# standard output.
# Default: 4096
MODEL_READ_BUFFER_SIZE = 4096

# Maximum number of child-process output messages retained in the
# read queue.
# When the queue is full, the oldest message is removed before the
# newest message is appended.
# Default: 1024
MODEL_MAX_READ_QUEUE_SIZE = 1024

# Web UI settings

# Build directory used by the Web UI build task.
# Default: <TEMP>/build-webui
WEBUI_BUILD_DIR = "/tmp/build-webui"

# Installation and release settings

# Directory searched for shared libraries when preparing the
# installation directory for release packaging.
# Examples:
#   vcpkg: C:/vcpkg/installed/x64-windows/bin
#   Homebrew: /opt/homebrew/lib
# Leave empty if no additional library search directory is required.
# Default: ""
BUNDLE_LIB_SEARCH_DIR = ""

# Installation prefix for the server, CLI, and gateway.
# The release package is created from the contents of this directory.
# Default: "<TEMP>/install"
INSTALL_PREFIX = "/tmp/install"

# Directory where release archives and their associated files are written.
#
# Packages built for different operating systems and CPU architectures
# can be collected in this directory before checksums and GPG signatures
# are generated.
#
# Default: "<TEMP>/release"
RELEASE_OUTPUT_DIR = "/tmp/release"

# GPG signing key ID or fingerprint used to create detached signatures
# for release archives and checksum files.
# Default: ""
RELEASE_GPG_ID = ""

# Path to the GPG public key used to verify release signatures.
# Leave empty to skip signature verification.
# Default: ""
RELEASE_GPG_PUBLIC_KEY_FILE = ""
